# MintSCAN saved scanner profile - lives at ENV:MintSCAN/Unit0 (and
# ENVARC:MintSCAN/Unit0 for persistence across reboots). Written by
# MintScan's Save button; this file just documents the format.
HOST=192.168.1.50
PORT=80
MODEL=Example MFC-1234DW
SOURCE=Platen
COLORMODE=RGB24
RESOLUTION=300
FORMAT=image/jpeg
PAGESIZE=A4
SAVEPATH=RAM:scan001.jpg
