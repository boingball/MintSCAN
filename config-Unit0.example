# MintSCAN saved scanner profile - lives at ENV:MintSCAN/UnitN (and
# ENVARC:MintSCAN/UnitN for persistence across reboots), where N is
# 0-7, one of the eight profiles switchable from the Unit dropdown.
# Written by MintScan's Save Config button; this file documents the format.
HOST=192.168.1.50
PORT=80
ROOT=/eSCL
MODEL=Example MFC-1234DW
SOURCE=Platen
COLORMODE=RGB24
RESOLUTION=300
FORMAT=image/jpeg
PAGESIZE=A4
SAVEPATH=RAM:scan001.jpg
